<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>

<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>

<meta
    name="theme-color"
    content="#075985"
>

<title>
انجمن سازندگان ذیصلاح ساختمان شهرستان ارومیه
</title>


<style>

/* ==============================
   RESET
============================== */

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}


/* ==============================
   BODY
============================== */

body{

    font-family:
        Tahoma,
        Arial,
        sans-serif;

    background:
        #eef7fc;

    color:
        #172033;

    min-height:
        100vh;

}


/* ==============================
   HEADER
============================== */

header{

    background:
        linear-gradient(
            135deg,
            #075985,
            #0284c7
        );

    color:white;

    padding:18px;

    box-shadow:
        0 5px 25px
        rgba(0,0,0,.15);

}


.header{

    max-width:
        1200px;

    margin:auto;

    display:flex;

    justify-content:
        space-between;

    align-items:
        center;

    gap:20px;

}


/* ==============================
   BRAND
============================== */

.brand{

    display:flex;

    align-items:center;

    gap:15px;

}


.logo-image{

    width:70px;

    height:70px;

    object-fit:contain;

    border-radius:50%;

    background:white;

    padding:3px;

    flex-shrink:0;

}


.logo-text{

    font-size:20px;

    font-weight:bold;

    line-height:1.7;

}


/* ==============================
   LIVE
============================== */

.live{

    display:flex;

    align-items:center;

    gap:8px;

    font-size:14px;

    white-space:nowrap;

}


.dot{

    width:11px;

    height:11px;

    border-radius:50%;

    background:#22c55e;

    box-shadow:
        0 0 12px
        #22c55e;

}


/* ==============================
   MAIN
============================== */

main{

    max-width:
        1200px;

    margin:auto;

    padding:
        25px 15px 50px;

}


/* ==============================
   ERROR
============================== */

.error{

    display:none;

    background:#fee2e2;

    color:#991b1b;

    padding:15px;

    border-radius:12px;

    margin-bottom:20px;

    line-height:1.8;

}


/* ==============================
   HERO
============================== */

.hero{

    background:
        linear-gradient(
            135deg,
            #0284c7,
            #0f766e
        );

    color:white;

    border-radius:26px;

    padding:32px;

    margin-bottom:20px;

    box-shadow:
        0 15px 40px
        rgba(2,132,199,.25);

}


.hero h1{

    font-size:
        clamp(
            28px,
            5vw,
            42px
        );

    margin-bottom:10px;

}


.subtitle{

    font-size:17px;

    opacity:.9;

    margin-bottom:25px;

}


.current{

    display:flex;

    align-items:center;

    gap:22px;

    flex-wrap:wrap;

}


.icon{

    font-size:75px;

}


.temp{

    font-size:
        clamp(
            65px,
            10vw,
            90px
        );

    font-weight:bold;

    line-height:1;

}


.desc{

    font-size:20px;

    margin-top:10px;

}


.update{

    margin-top:22px;

    font-size:13px;

    opacity:.85;

}


/* ==============================
   CURRENT CARDS
============================== */

.cards{

    display:grid;

    grid-template-columns:
        repeat(4,1fr);

    gap:15px;

}


.card{

    background:white;

    border-radius:20px;

    padding:22px;

    text-align:center;

    box-shadow:
        0 8px 25px
        rgba(0,0,0,.07);

}


.card-icon{

    font-size:35px;

    margin-bottom:10px;

}


.label{

    color:#64748b;

    font-size:14px;

    margin-bottom:8px;

}


.value{

    font-size:24px;

    font-weight:bold;

}


/* ==============================
   SECTION TITLE
============================== */

.title{

    font-size:24px;

    margin:
        32px 0 15px;

}


/* ==============================
   FORECAST
============================== */

.forecast{

    display:grid;

    grid-template-columns:
        repeat(7,1fr);

    gap:10px;

}


.day{

    background:white;

    border-radius:18px;

    padding:17px 8px;

    text-align:center;

    box-shadow:
        0 8px 20px
        rgba(0,0,0,.06);

}


.day-name{

    font-weight:bold;

    margin-bottom:7px;

}


.day-date{

    color:#64748b;

    font-size:11px;

}


.day-icon{

    font-size:36px;

    margin:12px 0;

}


.day-temp{

    font-size:18px;

    font-weight:bold;

}


.day-info{

    font-size:12px;

    color:#475569;

    line-height:2;

    margin-top:10px;

}


/* ==============================
   RAIN
============================== */

.rain-grid{

    display:grid;

    grid-template-columns:
        repeat(3,1fr);

    gap:15px;

}


.rain-card{

    background:white;

    border-radius:20px;

    padding:22px;

    box-shadow:
        0 8px 25px
        rgba(0,0,0,.07);

}


.rain-title{

    font-weight:bold;

    margin-bottom:10px;

}


.rain-value{

    font-size:30px;

    font-weight:bold;

}


/* ==============================
   AIR
============================== */

.air{

    background:white;

    border-radius:20px;

    padding:22px;

    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:20px;

    box-shadow:
        0 8px 25px
        rgba(0,0,0,.07);

}


.air-title{

    font-size:19px;

    font-weight:bold;

    margin-bottom:8px;

}


.air-text{

    color:#64748b;

    font-size:13px;

    line-height:1.8;

}


.air-status{

    background:#dcfce7;

    color:#166534;

    padding:12px 22px;

    border-radius:30px;

    font-weight:bold;

    white-space:nowrap;

}


/* ==============================
   FOOTER
============================== */

footer{

    background:#0f172a;

    color:#cbd5e1;

    text-align:center;

    padding:30px 15px;

    line-height:1.8;

}


/* ==============================
   TABLET
============================== */

@media(max-width:900px){

    .cards{

        grid-template-columns:
            repeat(2,1fr);

    }


    .forecast{

        grid-template-columns:
            repeat(4,1fr);

    }

}


/* ==============================
   MOBILE
============================== */

@media(max-width:600px){

    header{

        padding:15px;

    }


    .header{

        flex-direction:column;

        align-items:flex-start;

    }


    .brand{

        width:100%;

    }


    .logo-image{

        width:58px;

        height:58px;

    }


    .logo-text{

        font-size:15px;

        line-height:1.7;

    }


    .live{

        align-self:flex-end;

    }


    main{

        padding:
            18px 12px 40px;

    }


    .hero{

        padding:24px;

        border-radius:23px;

    }


    .hero h1{

        font-size:29px;

    }


    .subtitle{

        font-size:16px;

        line-height:1.9;

    }


    .current{

        gap:10px;

    }


    .icon{

        font-size:55px;

    }


    .temp{

        font-size:65px;

    }


    .desc{

        font-size:17px;

    }


    .cards{

        grid-template-columns:
            repeat(2,1fr);

        gap:10px;

    }


    .card{

        padding:
            18px 8px;

    }


    .value{

        font-size:21px;

    }


    .forecast{

        display:flex;

        overflow-x:auto;

        padding-bottom:8px;

    }


    .day{

        min-width:135px;

    }


    .rain-grid{

        grid-template-columns:1fr;

    }


    .air{

        flex-direction:column;

        align-items:flex-start;

    }

}


/* ==============================
   VERY SMALL MOBILE
============================== */

@media(max-width:380px){

    .logo-text{

        font-size:13px;

    }


    .logo-image{

        width:52px;

        height:52px;

    }


    .temp{

        font-size:58px;

    }

}

</style>

</head>


<body>


<!-- =================================
     HEADER
================================= -->

<header>

<div class="header">


<div class="brand">


<img
    src="logo.jpg"
    alt="لوگوی انجمن سازندگان ذیصلاح ساختمان شهرستان ارومیه"
    class="logo-image"
>


<div class="logo-text">

انجمن سازندگان ذیصلاح ساختمان شهرستان ارومیه

</div>


</div>


<div class="live">

<span class="dot"></span>

اطلاعات زنده

</div>


</div>

</header>



<main>


<!-- =================================
     ERROR
================================= -->

<div
    id="error"
    class="error"
></div>



<!-- =================================
     CURRENT WEATHER
================================= -->

<section class="hero">


<h1>

هواشناسی ارومیه

</h1>


<div class="subtitle">

وضعیت لحظه‌ای آب‌وهوا و پیش‌بینی روزهای آینده

</div>


<div class="current">


<div
    id="weatherIcon"
    class="icon"
>

🌤️

</div>


<div>


<div
    id="temperature"
    class="temp"
>

--

</div>


<div
    id="description"
    class="desc"
>

در حال دریافت اطلاعات...

</div>


</div>


</div>


<div class="update">

آخرین بروزرسانی:

<span id="update">

--

</span>

</div>


</section>



<!-- =================================
     CURRENT INFORMATION
================================= -->

<section class="cards">


<div class="card">

<div class="card-icon">
🌡️
</div>

<div class="label">
دمای احساس‌شده
</div>

<div
    id="feels"
    class="value"
>
--°
</div>

</div>



<div class="card">

<div class="card-icon">
💧
</div>

<div class="label">
رطوبت هوا
</div>

<div
    id="humidity"
    class="value"
>
--%
</div>

</div>



<div class="card">

<div class="card-icon">
💨
</div>

<div class="label">
سرعت باد
</div>

<div
    id="wind"
    class="value"
>
-- km/h
</div>

</div>



<div class="card">

<div class="card-icon">
🧭
</div>

<div class="label">
جهت باد
</div>

<div
    id="windDirection"
    class="value"
>
--
</div>

</div>


</section>



<!-- =================================
     FORECAST
================================= -->

<h2 class="title">

📅 پیش‌بینی ۷ روز آینده

</h2>


<section
    id="forecast"
    class="forecast"
>


<div class="day">

در حال دریافت پیش‌بینی...

</div>


</section>



<!-- =================================
     RAIN
================================= -->

<h2 class="title">

🌧️ وضعیت بارش امروز

</h2>


<section class="rain-grid">


<div class="rain-card">


<div class="rain-title">

🌧️ احتمال بارش

</div>


<div
    id="rainProbability"
    class="rain-value"
>

--%

</div>


</div>



<div class="rain-card">


<div class="rain-title">

🌧️ مقدار باران

</div>


<div
    id="rainAmount"
    class="rain-value"
>

-- mm

</div>


</div>



<div class="rain-card">


<div class="rain-title">

❄️ مقدار برف

</div>


<div
    id="snowAmount"
    class="rain-value"
>

-- cm

</div>


</div>


</section>



<!-- =================================
     AIR QUALITY
================================= -->

<h2 class="title">

🫁 کیفیت هوا

</h2>


<section class="air">


<div>


<div class="air-title">

کیفیت هوای ارومیه

</div>


<div
    id="airText"
    class="air-text"
>

در حال بررسی کیفیت هوا...

</div>


</div>


<div
    id="airStatus"
    class="air-status"
>

در حال بررسی

</div>


</section>


</main>



<!-- =================================
     FOOTER
================================= -->

<footer>


<strong>

انجمن سازندگان ذیصلاح ساختمان شهرستان ارومیه

</strong>


<br>


دما • باد • بارش • رطوبت • پیش‌بینی هوا


<br><br>


<span id="year"></span>


</footer>



<script>


/* =================================
   مختصات ارومیه
================================= */

const LAT = 37.5527;

const LON = 45.0761;



/* =================================
   ساخت آدرس هواشناسی
================================= */

const weatherParams =
new URLSearchParams({

    latitude: LAT,

    longitude: LON,

    current:
    "temperature_2m,relative_humidity_2m,apparent_temperature,wind_speed_10m,wind_direction_10m,weather_code",

    daily:
    "weather_code,temperature_2m_max,temperature_2m_min,wind_speed_10m_max,precipitation_probability_max,rain_sum,snowfall_sum",

    timezone:
    "Asia/Tehran",

    forecast_days:
    "7"

});


const WEATHER_URL =
"https://api.open-meteo.com/v1/forecast?"
+
weatherParams.toString();



/* =================================
   وضعیت آب‌وهوا
================================= */

function weatherInfo(code){

    const weather = {

        0:["☀️","صاف"],

        1:["🌤️","عمدتاً صاف"],

        2:["⛅","نیمه‌ابری"],

        3:["☁️","ابری"],

        45:["🌫️","مه‌آلود"],

        48:["🌫️","مه‌آلود"],

        51:["🌦️","نم‌نم باران"],

        53:["🌦️","باران خفیف"],

        55:["🌧️","باران"],

        61:["🌧️","باران خفیف"],

        63:["🌧️","باران"],

        65:["🌧️","باران شدید"],

        71:["🌨️","برف خفیف"],

        73:["❄️","برف"],

        75:["❄️","برف شدید"],

        77:["❄️","دانه‌های برف"],

        80:["🌦️","رگبار"],

        81:["🌧️","رگبار باران"],

        82:["⛈️","رگبار شدید"],

        85:["🌨️","رگبار برف"],

        86:["❄️","رگبار برف شدید"],

        95:["⛈️","رعدوبرق"],

        96:["⛈️","رعدوبرق و تگرگ"],

        99:["⛈️","رعدوبرق شدید"]

    };


    return weather[code]
    ||
    ["🌤️","نامشخص"];

}



/* =================================
   جهت باد
================================= */

function getWindDirection(degree){

    const directions = [

        "شمال",

        "شمال‌شرق",

        "شرق",

        "جنوب‌شرق",

        "جنوب",

        "جنوب‌غرب",

        "غرب",

        "شمال‌غرب"

    ];


    return directions[
        Math.round(degree / 45) % 8
    ];

}



/* =================================
   نمایش خطا
================================= */

function showError(message){

    const error =
    document.getElementById("error");


    error.innerText =
    "⚠️ " + message;


    error.style.display =
    "block";

}



/* =================================
   دریافت هوا
================================= */

async function loadWeather(){

    try{


        const response =
        await fetch(
            WEATHER_URL,
            {
                cache:"no-store"
            }
        );


        if(!response.ok){

            throw new Error(
                "API هواشناسی پاسخ صحیح نداد."
            );

        }


        const data =
        await response.json();


        console.log(
            "Weather:",
            data
        );


        if(!data.current){

            throw new Error(
                "اطلاعات هوا دریافت نشد."
            );

        }


        const current =
        data.current;


        /* -----------------------------
           وضعیت فعلی
        ----------------------------- */


        const weather =
        weatherInfo(
            current.weather_code
        );


        document.getElementById(
            "weatherIcon"
        ).innerText =
        weather[0];


        document.getElementById(
            "temperature"
        ).innerText =
        Math.round(
            current.temperature_2m
        ) + "°";


        document.getElementById(
            "description"
        ).innerText =
        weather[1];


        /* -----------------------------
           احساس دما
        ----------------------------- */


        document.getElementById(
            "feels"
        ).innerText =
        Math.round(
            current.apparent_temperature
        ) + "°";


        /* -----------------------------
           رطوبت
        ----------------------------- */


        document.getElementById(
            "humidity"
        ).innerText =
        current.relative_humidity_2m
        + "%";


        /* -----------------------------
           باد
        ----------------------------- */


        document.getElementById(
            "wind"
        ).innerText =
        Math.round(
            current.wind_speed_10m
        )
        + " km/h";


        /* -----------------------------
           جهت باد
        ----------------------------- */


        document.getElementById(
            "windDirection"
        ).innerText =
        getWindDirection(
            current.wind_direction_10m
        );


        /* -----------------------------
           زمان
        ----------------------------- */


        document.getElementById(
            "update"
        ).innerText =
        new Date().toLocaleTimeString(
            "fa-IR"
        );


        /* -----------------------------
           پیش‌بینی
        ----------------------------- */


        showForecast(
            data.daily
        );


        /* -----------------------------
           بارش
        ----------------------------- */


        showRain(
            data.daily
        );


    }

    catch(error){

        console.error(
            "Weather error:",
            error
        );


        document.getElementById(
            "description"
        ).innerText =
        "خطا در دریافت اطلاعات";


        showError(
            "ارتباط با سرویس هواشناسی برقرار نشد."
        );

    }

}



/* =================================
   پیش‌بینی ۷ روزه
================================= */

function showForecast(daily){

    const box =
    document.getElementById(
        "forecast"
    );


    box.innerHTML =
    "";


    for(
        let i = 0;
        i < daily.time.length;
        i++
    ){


        let dayName;


        if(i === 0){

            dayName =
            "امروز";

        }

        else if(i === 1){

            dayName =
            "فردا";

        }

        else{

            dayName =
            new Date(
                daily.time[i]
            ).toLocaleDateString(
                "fa-IR",
                {
                    weekday:"long"
                }
            );

        }


        const weather =
        weatherInfo(
            daily.weather_code[i]
        );


        const card =
        document.createElement(
            "div"
        );


        card.className =
        "day";


        card.innerHTML = `

            <div class="day-name">

                ${dayName}

            </div>


            <div class="day-date">

                ${new Date(
                    daily.time[i]
                ).toLocaleDateString(
                    "fa-IR"
                )}

            </div>


            <div class="day-icon">

                ${weather[0]}

            </div>


            <div>

                ${weather[1]}

            </div>


            <div class="day-temp">

                ${Math.round(
                    daily.temperature_2m_max[i]
                )}°

                /

                ${Math.round(
                    daily.temperature_2m_min[i]
                )}°

            </div>


            <div class="day-info">

                💨 باد:
                ${Math.round(
                    daily.wind_speed_10m_max[i]
                )}
                km/h

                <br>

                🌧️ احتمال بارش:
                ${daily.precipitation_probability_max[i] || 0}%

                <br>

                🌧️ باران:
                ${(daily.rain_sum[i] || 0).toFixed(1)}
                mm

                <br>

                ❄️ برف:
                ${(daily.snowfall_sum[i] || 0).toFixed(1)}
                cm

            </div>

        `;


        box.appendChild(
            card
        );

    }

}



/* =================================
   بارش امروز
================================= */

function showRain(daily){

    const probability =
    daily.precipitation_probability_max[0]
    || 0;


    const rain =
    daily.rain_sum[0]
    || 0;


    const snow =
    daily.snowfall_sum[0]
    || 0;


    document.getElementById(
        "rainProbability"
    ).innerText =
    probability + "%";


    document.getElementById(
        "rainAmount"
    ).innerText =
    rain.toFixed(1)
    + " mm";


    document.getElementById(
        "snowAmount"
    ).innerText =
    snow.toFixed(1)
    + " cm";

}
